#include <stdio.h>

int main() {
    int num, range;

    printf("Enter an integer to generate its table: ");
    scanf("%d", &num);

    printf("Enter the limit (e.g., 10 or 12): ");
    scanf("%d", &range);

    printf("\nMultiplication Table for %d:\n", num);
    printf("-------------------------------\n");
    for (int i = 1; i <= range; i++) {
        printf("%d x %2d = %d\n", num, i, num * i);
    }

    return 0;
}
