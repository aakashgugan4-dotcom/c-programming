#include <stdio.h>

int main() {
    int N, i, sum = 0;

    printf("Enter a positive integer N: ");
    if (scanf("%d", &N) != 1 || N < 1) {
        printf("Please enter a valid positive integer.\n");
        return 1;
    }


    for (i = 1; i <= N; i++) {
        sum += i;
    }

    printf("The sum of numbers from 1 to %d is: %d\n", N, sum);

    return 0;
}
