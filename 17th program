#include <stdio.h>

int main() {
    int limit, i;
    
    printf("Enter the upper limit (e.g., 50): ");
    if (scanf("%d", &limit) != 1 || limit < 2) {
        printf("Please enter a valid positive integer greater than or equal to 2.\n");
        return 1;
    }

    
    printf("Even numbers from 1 to %d:\n", limit);
    for (i = 2; i <= limit; i += 2) {
        printf("%d ", i);
    }
    printf("\n");

    return 0;
}
