#include <stdio.h>
#include <stdbool.h>

int main() {
    long long num;
    bool isPrime = true;

    printf("Enter a positive integer: ");
    scanf("%lld", &num);

    if (num <= 1) {
        isPrime = false;
    } else {
        // Check for factors up to sqrt(num)
        for (long long i = 2; i * i <= num; i++) {
            if (num % i == 0) {
                isPrime = false; // Found a factor, so it's not prime
                break;
            }
        }
    }

    if (isPrime) {
        printf("%lld is a prime number.\n", num);
    } else {
        printf("%lld is not a prime number.\n", num);
    }

    return 0;
}
